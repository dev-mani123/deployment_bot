name: Deployment PR Bot

on:
  workflow_dispatch:
    inputs:
      ticket:
        description: "Deployment ticket"
        required: true
        type: string

      client:
        description: "Client name (case-insensitive)"
        required: true
        type: string

      target:
        description: "Deployment target"
        required: true
        type: choice
        options:
          - qa_next
          - qa_stable
          - uat_stable
          - uat_preview
          - production_a
          - production_b

      release:
        description: "Release version"
        required: true
        type: string

permissions:
  contents: write
  pull-requests: write

jobs:
  create-deployment-pr:
    runs-on: ubuntu-latest

    steps:

      # ============================================================
      # 1. CHECKOUT
      # ============================================================

      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # ============================================================
      # 2. NORMALIZE AND VALIDATE INPUTS
      # ============================================================

      - name: Normalize and validate inputs
        id: inputs
        shell: bash
        env:
          INPUT_TICKET: ${{ inputs.ticket }}
          INPUT_CLIENT: ${{ inputs.client }}
          INPUT_TARGET: ${{ inputs.target }}
          INPUT_RELEASE: ${{ inputs.release }}
        run: |
          TICKET="$(printf '%s' "$INPUT_TICKET" | xargs)"
          CLIENT="$(printf '%s' "$INPUT_CLIENT" | xargs)"
          TARGET_INPUT="$(printf '%s' "$INPUT_TARGET" | xargs)"
          RELEASE="$(printf '%s' "$INPUT_RELEASE" | xargs)"

          if [ -z "$TICKET" ]; then
            echo "::error::Ticket cannot be empty."
            exit 1
          fi

          if [ -z "$CLIENT" ]; then
            echo "::error::Client cannot be empty."
            exit 1
          fi

          if [ -z "$TARGET_INPUT" ]; then
            echo "::error::Target cannot be empty."
            exit 1
          fi

          if [ -z "$RELEASE" ]; then
            echo "::error::Release cannot be empty."
            exit 1
          fi

          if [[ ! "$TICKET" =~ ^[A-Za-z0-9._-]+$ ]]; then
            echo "::error::Invalid ticket: $TICKET"
            exit 1
          fi

          if [[ ! "$CLIENT" =~ ^[A-Za-z0-9._-]+$ ]]; then
            echo "::error::Invalid client: $CLIENT"
            exit 1
          fi

          if [[ ! "$RELEASE" =~ ^[A-Za-z0-9._-]+$ ]]; then
            echo "::error::Invalid release: $RELEASE"
            exit 1
          fi

          # --------------------------------------------------------
          # Target input is case-insensitive.
          #
          # User input:
          # UAT_STABLE
          # uat_stable
          # Uat_Stable
          #
          # all become:
          # uat_stable
          # --------------------------------------------------------

          TARGET_NORMALIZED="$(
            printf '%s' "$TARGET_INPUT" |
            tr '[:upper:]' '[:lower:]'
          )"

          # --------------------------------------------------------
          # COMMAND TARGET -> YAML TARGET
          # --------------------------------------------------------

          case "$TARGET_NORMALIZED" in
            qa_next)
              ACTUAL_TARGET="qa-next"
              ;;

            qa_stable)
              ACTUAL_TARGET="qa-stable"
              ;;

            uat_stable)
              ACTUAL_TARGET="uat-stable"
              ;;

            uat_preview)
              ACTUAL_TARGET="uat-preview"
              ;;

            production_a)
              ACTUAL_TARGET="production-a"
              ;;

            production_b)
              ACTUAL_TARGET="production-b"
              ;;

            *)
              echo "::error::Unsupported deployment target: $TARGET_INPUT"

              echo ""
              echo "Supported targets:"
              echo "qa_next"
              echo "qa_stable"
              echo "uat_stable"
              echo "uat_preview"
              echo "production_a"
              echo "production_b"

              exit 1
              ;;
          esac

          TICKET_LOWER="$(
            printf '%s' "$TICKET" |
            tr '[:upper:]' '[:lower:]'
          )"

          echo "ticket=$TICKET" >> "$GITHUB_OUTPUT"
          echo "ticket_lower=$TICKET_LOWER" >> "$GITHUB_OUTPUT"

          echo "client_input=$CLIENT" >> "$GITHUB_OUTPUT"

          echo "target_input=$TARGET_INPUT" >> "$GITHUB_OUTPUT"
          echo "target_normalized=$TARGET_NORMALIZED" >> "$GITHUB_OUTPUT"
          echo "actual_target=$ACTUAL_TARGET" >> "$GITHUB_OUTPUT"

          echo "release=$RELEASE" >> "$GITHUB_OUTPUT"

          echo ""
          echo "Input validation successful."
          echo ""
          echo "Target mapping:"
          echo "$TARGET_INPUT -> $ACTUAL_TARGET"

      # ============================================================
      # 3. DISPLAY REQUEST
      # ============================================================

      - name: Display deployment request
        shell: bash
        run: |
          echo "================================"
          echo "Deployment PR Bot"
          echo "================================"

          echo "Ticket:"
          echo "${{ steps.inputs.outputs.ticket }}"

          echo ""
          echo "Client:"
          echo "${{ steps.inputs.outputs.client_input }}"

          echo ""
          echo "Command target:"
          echo "${{ steps.inputs.outputs.target_input }}"

          echo ""
          echo "Config target:"
          echo "${{ steps.inputs.outputs.actual_target }}"

          echo ""
          echo "Release:"
          echo "${{ steps.inputs.outputs.release }}"

          echo "================================"

      # ============================================================
      # 4. RESOLVE CLIENT CASE-INSENSITIVELY
      # ============================================================

      - name: Resolve client configuration
        id: config
        shell: bash
        env:
          CLIENT_INPUT: ${{ steps.inputs.outputs.client_input }}
        run: |
          CLIENT_ROOT="platform-client/clients"

          if [ ! -d "$CLIENT_ROOT" ]; then
            echo "::error::Client root not found: $CLIENT_ROOT"
            exit 1
          fi

          MATCH_COUNT=0
          MATCHED_DIRECTORY=""

          while IFS= read -r CLIENT_DIRECTORY; do

            DIRECTORY_NAME="$(basename "$CLIENT_DIRECTORY")"

            if [[ "${DIRECTORY_NAME,,}" == "${CLIENT_INPUT,,}" ]]; then

              MATCH_COUNT=$((MATCH_COUNT + 1))

              MATCHED_DIRECTORY="$CLIENT_DIRECTORY"

            fi

          done < <(
            find "$CLIENT_ROOT" \
              -mindepth 1 \
              -maxdepth 1 \
              -type d \
              -print
          )

          if [ "$MATCH_COUNT" -eq 0 ]; then

            echo "::error::Client '$CLIENT_INPUT' was not found."

            echo ""
            echo "Available clients:"

            find "$CLIENT_ROOT" \
              -mindepth 1 \
              -maxdepth 1 \
              -type d \
              -printf '%f\n' |
              sort -f

            exit 1
          fi

          if [ "$MATCH_COUNT" -gt 1 ]; then

            echo "::error::Multiple client directories match '$CLIENT_INPUT' case-insensitively."

            echo "Refusing to guess."

            exit 1
          fi

          ACTUAL_CLIENT="$(basename "$MATCHED_DIRECTORY")"

          CONFIG_FILE="${MATCHED_DIRECTORY}/config.yml"

          if [ ! -f "$CONFIG_FILE" ]; then

            echo "::error::config.yml not found for client '$ACTUAL_CLIENT'."

            echo "Expected:"
            echo "$CONFIG_FILE"

            exit 1
          fi

          echo ""
          echo "Client resolved:"
          echo "$CLIENT_INPUT -> $ACTUAL_CLIENT"

          echo ""
          echo "Configuration:"
          echo "$CONFIG_FILE"

          echo "actual_client=$ACTUAL_CLIENT" >> "$GITHUB_OUTPUT"

          echo "config_file=$CONFIG_FILE" >> "$GITHUB_OUTPUT"

      # ============================================================
      # 5. FIND TARGET AND CURRENT RELEASE
      #
      # YAML may contain:
      #
      # qa-next: &qa
      # qa-stable:
      # uat-stable: &uat
      # uat-preview:
      # production-a: &production
      # production-b:
      # ============================================================

      - name: Read deployment target
        id: target
        shell: bash
        env:
          CONFIG_FILE: ${{ steps.config.outputs.config_file }}
          TARGET: ${{ steps.inputs.outputs.actual_target }}
        run: |
          node - "$CONFIG_FILE" "$TARGET" <<'NODE'
          const fs = require("fs");

          const file = process.argv[2];

          const target = process.argv[3];

          const content =
            fs.readFileSync(file, "utf8");

          const lines =
            content.split(/\r?\n/);

          const escapedTarget =
            target.replace(
              /[.*+?^${}()|[\]\\]/g,
              "\\$&"
            );

          /*
           * Supports:
           *
           * qa-next: &qa
           * qa-stable:
           * uat-stable: &uat
           * uat-preview:
           * production-a: &production
           * production-b:
           */
          const targetPattern =
            new RegExp(
              `^${escapedTarget}:\\s*(?:&[A-Za-z0-9._-]+)?\\s*$`,
              "i"
            );

          let targetFound = false;

          let actualTarget = null;

          let currentRelease = null;

          for (
            let i = 0;
            i < lines.length;
            i++
          ) {

            const line = lines[i];

            if (
              !targetPattern.test(
                line.trim()
              )
            ) {
              continue;
            }

            targetFound = true;

            /*
             * Capture the actual YAML key.
             */
            const sectionMatch =
              line.trim().match(
                /^([A-Za-z0-9._-]+):/
              );

            actualTarget =
              sectionMatch[1];

            const targetIndent =
              line.length -
              line.trimStart().length;

            for (
              let j = i + 1;
              j < lines.length;
              j++
            ) {

              const nextLine =
                lines[j];

              if (!nextLine.trim()) {
                continue;
              }

              const nextIndent =
                nextLine.length -
                nextLine.trimStart().length;

              if (
                nextIndent <= targetIndent &&
                /^[A-Za-z0-9._-]+:/.test(
                  nextLine.trim()
                )
              ) {
                break;
              }

              const releaseMatch =
                nextLine.match(
                  /^\s*continuous_deploy_tag:\s*([^\s#]+)/
                );

              if (releaseMatch) {

                currentRelease =
                  releaseMatch[1];

                break;
              }
            }

            break;
          }

          if (!targetFound) {

            console.error(
              `ERROR: Target '${target}' was not found in ${file}.`
            );

            process.exit(1);
          }

          if (!currentRelease) {

            console.error(
              `ERROR: continuous_deploy_tag was not found under '${target}'.`
            );

            process.exit(1);
          }

          console.log("");
          console.log("Target resolved:");
          console.log(actualTarget);

          console.log("");
          console.log(
            `Current release: ${currentRelease}`
          );

          fs.appendFileSync(
            process.env.GITHUB_OUTPUT,
            `actual_target=${actualTarget}\n`
          );

          fs.appendFileSync(
            process.env.GITHUB_OUTPUT,
            `current_release=${currentRelease}\n`
          );
          NODE

      # ============================================================
      # 6. VALIDATE RELEASE
      # ============================================================

      - name: Validate requested release
        shell: bash
        env:
          CURRENT_RELEASE: ${{ steps.target.outputs.current_release }}
          REQUESTED_RELEASE: ${{ steps.inputs.outputs.release }}
        run: |
          if [[ "${CURRENT_RELEASE,,}" == "${REQUESTED_RELEASE,,}" ]]; then

            echo "::error::Release '$REQUESTED_RELEASE' is already configured."

            exit 1

          fi

          echo "Current release:"
          echo "$CURRENT_RELEASE"

          echo ""
          echo "Requested release:"
          echo "$REQUESTED_RELEASE"

          echo ""
          echo "Release change required."

      # ============================================================
      # 7. CHECK DUPLICATE BRANCH CASE-INSENSITIVELY
      # ============================================================

      - name: Check duplicate branch
        shell: bash
        env:
          REQUESTED_BRANCH: ${{ steps.inputs.outputs.ticket }}
        run: |
          MATCHING_BRANCH=""

          while IFS= read -r REMOTE_BRANCH; do

            BRANCH_NAME="${REMOTE_BRANCH#refs/heads/}"

            if [[ "${BRANCH_NAME,,}" == "${REQUESTED_BRANCH,,}" ]]; then

              MATCHING_BRANCH="$BRANCH_NAME"

              break

            fi

          done < <(
            git ls-remote \
              --heads \
              origin |
              awk '{print $2}'
          )

          if [ -n "$MATCHING_BRANCH" ]; then

            echo "::error::Branch already exists ignoring case."

            echo "Requested:"
            echo "$REQUESTED_BRANCH"

            echo ""
            echo "Existing:"
            echo "$MATCHING_BRANCH"

            exit 1

          fi

          echo "No duplicate branch found."

      # ============================================================
      # 8. CHECK DUPLICATE OPEN PR
      # ============================================================

      - name: Check duplicate Pull Request
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          REQUESTED_BRANCH: ${{ steps.inputs.outputs.ticket }}
        run: |
          EXISTING_PR=""

          while IFS='|' read -r PR_NUMBER PR_HEAD PR_URL; do

            if [[ "${PR_HEAD,,}" == "${REQUESTED_BRANCH,,}" ]]; then

              EXISTING_PR="$PR_NUMBER|$PR_HEAD|$PR_URL"

              break

            fi

          done < <(
            gh pr list \
              --state open \
              --limit 100 \
              --json number,headRefName,url \
              --jq '.[] | "\(.number)|\(.headRefName)|\(.url)"'
          )

          if [ -n "$EXISTING_PR" ]; then

            IFS='|' read -r \
              PR_NUMBER \
              PR_HEAD \
              PR_URL <<< "$EXISTING_PR"

            echo "::error::Open Pull Request already exists."

            echo "PR:"
            echo "#$PR_NUMBER"

            echo ""
            echo "Branch:"
            echo "$PR_HEAD"

            echo ""
            echo "URL:"
            echo "$PR_URL"

            exit 1

          fi

          echo "No duplicate Pull Request found."

      # ============================================================
      # 9. UPDATE ONLY continuous_deploy_tag
      # ============================================================

      - name: Update continuous deploy tag
        id: update
        shell: bash
        env:
          CONFIG_FILE: ${{ steps.config.outputs.config_file }}
          ACTUAL_TARGET: ${{ steps.target.outputs.actual_target }}
          REQUESTED_RELEASE: ${{ steps.inputs.outputs.release }}
        run: |
          node - \
            "$CONFIG_FILE" \
            "$ACTUAL_TARGET" \
            "$REQUESTED_RELEASE" <<'NODE'

          const fs = require("fs");

          const file =
            process.argv[2];

          const target =
            process.argv[3];

          const requestedRelease =
            process.argv[4];

          const originalContent =
            fs.readFileSync(
              file,
              "utf8"
            );

          /*
           * Preserve CRLF or LF.
           */
          const lineEnding =
            originalContent.includes("\r\n")
              ? "\r\n"
              : "\n";

          const endedWithNewline =
            originalContent.endsWith("\n");

          const lines =
            originalContent.split(/\r?\n/);

          if (
            endedWithNewline &&
            lines.length > 0 &&
            lines[lines.length - 1] === ""
          ) {
            lines.pop();
          }

          const escapedTarget =
            target.replace(
              /[.*+?^${}()|[\]\\]/g,
              "\\$&"
            );

          const targetPattern =
            new RegExp(
              `^${escapedTarget}:\\s*(?:&[A-Za-z0-9._-]+)?\\s*$`,
              "i"
            );

          let targetFound = false;

          let tagFound = false;

          let oldRelease = null;

          for (
            let i = 0;
            i < lines.length;
            i++
          ) {

            const line =
              lines[i];

            if (
              !targetPattern.test(
                line.trim()
              )
            ) {
              continue;
            }

            targetFound = true;

            const targetIndent =
              line.length -
              line.trimStart().length;

            for (
              let j = i + 1;
              j < lines.length;
              j++
            ) {

              const nextLine =
                lines[j];

              if (!nextLine.trim()) {
                continue;
              }

              const nextIndent =
                nextLine.length -
                nextLine.trimStart().length;

              if (
                nextIndent <= targetIndent &&
                /^[A-Za-z0-9._-]+:/.test(
                  nextLine.trim()
                )
              ) {
                break;
              }

              const match =
                nextLine.match(
                  /^(\s*continuous_deploy_tag:\s*)([^\s#]+)(.*)$/
                );

              if (!match) {
                continue;
              }

              oldRelease =
                match[2];

              if (
                oldRelease.toLowerCase() ===
                requestedRelease.toLowerCase()
              ) {

                console.error(
                  `Release '${requestedRelease}' is already configured.`
                );

                process.exit(1);
              }

              /*
               * Replace ONLY the version.
               */
              lines[j] =
                `${match[1]}${requestedRelease}${match[3]}`;

              tagFound = true;

              break;
            }

            break;
          }

          if (!targetFound) {

            console.error(
              `ERROR: Target '${target}' was not found.`
            );

            process.exit(1);
          }

          if (!tagFound) {

            console.error(
              `ERROR: continuous_deploy_tag was not found under '${target}'.`
            );

            process.exit(1);
          }

          let newContent =
            lines.join(lineEnding);

          if (endedWithNewline) {
            newContent += lineEnding;
          }

          fs.writeFileSync(
            file,
            newContent,
            "utf8"
          );

          console.log("");
          console.log("Configuration updated.");

          console.log("");
          console.log(
            `${target}: ${oldRelease} -> ${requestedRelease}`
          );

          fs.appendFileSync(
            process.env.GITHUB_OUTPUT,
            `old_release=${oldRelease}\n`
          );
          NODE

      # ============================================================
      # 10. VERIFY ONLY ONE LINE CHANGED
      # ============================================================

      - name: Verify configuration change
        shell: bash
        env:
          CONFIG_FILE: ${{ steps.config.outputs.config_file }}
        run: |
          echo ""
          echo "================================"
          echo "GIT DIFF"
          echo "================================"

          git diff -- "$CONFIG_FILE"

          echo ""
          echo "================================"

          if git diff --quiet; then

            echo "::error::No configuration change was produced."

            exit 1

          fi

          CHANGED_FILES="$(
            git diff --name-only
          )"

          echo "Changed files:"
          echo "$CHANGED_FILES"

          if [ "$CHANGED_FILES" != "$CONFIG_FILE" ]; then

            echo "::error::Unexpected files were modified."

            exit 1

          fi

          ADDED_LINES="$(
            git diff \
              --numstat \
              -- "$CONFIG_FILE" |
              awk '{print $1}'
          )"

          REMOVED_LINES="$(
            git diff \
              --numstat \
              -- "$CONFIG_FILE" |
              awk '{print $2}'
          )"

          echo ""
          echo "Added lines:"
          echo "$ADDED_LINES"

          echo ""
          echo "Removed lines:"
          echo "$REMOVED_LINES"

          if [ "$ADDED_LINES" -ne 1 ]; then

            echo "::error::Expected exactly 1 added line."

            echo "Refusing to create PR."

            exit 1

          fi

          if [ "$REMOVED_LINES" -ne 1 ]; then

            echo "::error::Expected exactly 1 removed line."

            echo "Refusing to create PR."

            exit 1

          fi

          echo ""
          echo "Diff validation successful."

      # ============================================================
      # 11. CREATE BRANCH
      # ============================================================

      - name: Create deployment branch
        shell: bash
        env:
          BRANCH: ${{ steps.inputs.outputs.ticket }}
        run: |
          echo "Creating branch:"
          echo "$BRANCH"

          git checkout -b "$BRANCH"

      # ============================================================
      # 12. COMMIT
      # ============================================================

      - name: Commit configuration change
        shell: bash
        env:
          CONFIG_FILE: ${{ steps.config.outputs.config_file }}
          TICKET: ${{ steps.inputs.outputs.ticket }}
          CLIENT: ${{ steps.config.outputs.actual_client }}
          TARGET: ${{ steps.target.outputs.actual_target }}
          RELEASE: ${{ steps.inputs.outputs.release }}
        run: |
          git config \
            user.name \
            "deployment-pr-bot"

          git config \
            user.email \
            "deployment-pr-bot@users.noreply.github.com"

          git add "$CONFIG_FILE"

          git commit \
            -m "$TICKET: Deploy $RELEASE to $TARGET for $CLIENT"

      # ============================================================
      # 13. PUSH
      # ============================================================

      - name: Push deployment branch
        shell: bash
        env:
          BRANCH: ${{ steps.inputs.outputs.ticket }}
        run: |
          git push \
            origin \
            "$BRANCH"

      # ============================================================
      # 14. CREATE PR
      # ============================================================

      - name: Create Pull Request
        id: pr
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}

          TICKET: ${{ steps.inputs.outputs.ticket }}

          CLIENT: ${{ steps.config.outputs.actual_client }}

          TARGET: ${{ steps.target.outputs.actual_target }}

          COMMAND_TARGET: ${{ steps.inputs.outputs.target_normalized }}

          RELEASE: ${{ steps.inputs.outputs.release }}

          CONFIG_FILE: ${{ steps.config.outputs.config_file }}

          OLD_RELEASE: ${{ steps.update.outputs.old_release }}
        run: |
          PR_TITLE="$TICKET - Deploy $RELEASE to $TARGET for $CLIENT"

          PR_URL=$(gh pr create \
            --base "${{ github.event.repository.default_branch }}" \
            --head "$TICKET" \
            --title "$PR_TITLE" \
            --body "$(cat <<EOF
          ## Deployment Request

          **Deployment Ticket:** $TICKET

          **Client:** $CLIENT

          **Requested Target:** $COMMAND_TARGET

          **Configuration Target:** $TARGET

          **Release:** $RELEASE

          ## Configuration File

          \`$CONFIG_FILE\`

          ## Configuration Change

          **Target**

          \`$TARGET\`

          **Field**

          \`continuous_deploy_tag\`

          **Previous release**

          \`$OLD_RELEASE\`

          **New release**

          \`$RELEASE\`

          ## Branch

          \`$TICKET\`

          ---

          Created automatically by Deployment PR Bot.
          EOF
          )")

          echo "pr_url=$PR_URL" >> "$GITHUB_OUTPUT"

      # ============================================================
      # 15. SUMMARY
      # ============================================================

      - name: Deployment PR summary
        shell: bash
        run: |
          echo ""
          echo "================================"
          echo "DEPLOYMENT PR CREATED"
          echo "================================"

          echo ""
          echo "Ticket:"
          echo "${{ steps.inputs.outputs.ticket }}"

          echo ""
          echo "Client:"
          echo "${{ steps.config.outputs.actual_client }}"

          echo ""
          echo "Command target:"
          echo "${{ steps.inputs.outputs.target_normalized }}"

          echo ""
          echo "Configuration target:"
          echo "${{ steps.target.outputs.actual_target }}"

          echo ""
          echo "Configuration:"
          echo "${{ steps.config.outputs.config_file }}"

          echo ""
          echo "Previous release:"
          echo "${{ steps.update.outputs.old_release }}"

          echo ""
          echo "New release:"
          echo "${{ steps.inputs.outputs.release }}"

          echo ""
          echo "Branch:"
          echo "${{ steps.inputs.outputs.ticket }}"

          echo ""
          echo "Pull Request:"
          echo "${{ steps.pr.outputs.pr_url }}"

          echo ""
          echo "================================"
